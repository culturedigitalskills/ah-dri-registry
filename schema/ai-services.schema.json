{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://culturedigitalskills.github.io/ah-dri-registry/api/v1/schema/ai-services.schema.json",
  "title": "AI services",
  "description": "Products whose main purpose is chatting with or calling an AI model, one entry per version (free, institutional, API), because data terms differ by version.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "provider",
    "version",
    "last_checked"
  ],
  "properties": {
    "id": {
      "title": "ID",
      "description": "Short, permanent identifier: lowercase letters, numbers and hyphens, e.g. chatgpt-edu",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "name": {
      "title": "Name",
      "type": "string",
      "minLength": 1,
      "x-core": true
    },
    "provider": {
      "title": "Provider",
      "type": "string",
      "minLength": 1,
      "x-core": true
    },
    "version": {
      "title": "Version described",
      "description": "Data terms differ by version",
      "type": "string",
      "enum": [
        "Free consumer",
        "Paid individual",
        "Institutional / education",
        "API"
      ],
      "x-core": true
    },
    "access": {
      "title": "Access",
      "type": "string",
      "enum": [
        "App",
        "API",
        "App and API"
      ],
      "x-core": true
    },
    "institutional_licence": {
      "title": "Institutional licence",
      "type": "string",
      "enum": [
        "Yes",
        "No",
        "Check locally"
      ],
      "x-core": true
    },
    "trains_on_inputs": {
      "title": "Trains on inputs by default",
      "type": "string",
      "enum": [
        "Yes",
        "No",
        "Opt-out available",
        "Unknown"
      ],
      "x-core": true
    },
    "data_location": {
      "title": "Data location",
      "type": "string",
      "minLength": 1,
      "x-core": true
    },
    "sensitive_data": {
      "title": "Suitable for sensitive data",
      "type": "string",
      "enum": [
        "Yes",
        "No",
        "With conditions",
        "Unknown"
      ],
      "x-core": true
    },
    "cost": {
      "title": "Cost",
      "type": "string",
      "enum": [
        "Free",
        "Free + paid tiers",
        "Paid",
        "Pay per use"
      ],
      "x-core": true
    },
    "model_openness": {
      "title": "Model openness",
      "type": "string",
      "enum": [
        "Proprietary",
        "Open-weight",
        "Mixed"
      ]
    },
    "webpage": {
      "title": "Webpage",
      "type": "string",
      "pattern": "^https?://\\S+$",
      "x-core": true
    },
    "last_checked": {
      "title": "Last checked",
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "x-core": true
    },
    "notes": {
      "title": "Notes",
      "type": "string",
      "minLength": 1
    }
  }
}
